

# MediBook patient identity verification
MEDIBOOK_OTP_SECRET=

# smtp | development_file
MEDIBOOK_VERIFICATION_DELIVERY=smtp

MEDIBOOK_SMTP_HOST=
MEDIBOOK_SMTP_PORT=587
MEDIBOOK_SMTP_USERNAME=
MEDIBOOK_SMTP_PASSWORD=
MEDIBOOK_SMTP_FROM=
MEDIBOOK_SMTP_TLS=true

# Patient profile image storage
MEDIBOOK_PROFILE_STORAGE=local
MEDIBOOK_PROFILE_STORAGE_ROOT=var/profile-images
MEDIBOOK_PROFILE_MAX_BYTES=5242880


# Integration credential encryption at rest
MEDIBOOK_INTEGRATION_MASTER_KEY=

# Observability
MEDIBOOK_SYNC_WORKER_ID=


# M6 production hardening
MEDIBOOK_RATE_LIMIT_ENABLED=true
MEDIBOOK_RATE_LIMIT_AUTH_PER_MINUTE=30
MEDIBOOK_RATE_LIMIT_CHAT_PER_MINUTE=30
MEDIBOOK_RATE_LIMIT_WIDGET_PER_MINUTE=120
MEDIBOOK_RATE_LIMIT_PUBLIC_PER_MINUTE=240

MEDIBOOK_ADAPTER_TIMEOUT_SECONDS=15
MEDIBOOK_ADAPTER_CIRCUIT_FAILURES=5
MEDIBOOK_ADAPTER_CIRCUIT_COOLDOWN_SECONDS=30
