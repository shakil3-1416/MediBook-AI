"use client";

import {
  useMutation,
} from "@tanstack/react-query";

import {
  ArrowUp,
  Bot,
  LoaderCircle,
  Plus,
  UserRound,
} from "lucide-react";

import {
  FormEvent,
  useEffect,
  useRef,
  useState,
} from "react";

import {
  useSearchParams,
} from "next/navigation";

import {
  sendChatMessage,
} from "@/lib/api";

import {
  ChatActions,
} from "@/components/chat/chat-actions";

import type {
  ChatAction,
} from "@/types/api";

import {
  useChatStore,
} from "@/store/chat-store";


const quickActions = [
  "Find me a cardiologist in Dhanmondi",
  "Show Dr. Farhana Ahmed's availability tomorrow",
  "What appointments do I have?",
];


export default function AssistantPage() {
  const searchParams =
    useSearchParams();

  const [input, setInput] =
    useState("");

  const bottomRef =
    useRef<HTMLDivElement | null>(
      null
    );

  const initialActionSent =
    useRef(false);

  const {
    conversationId,
    messages,
    setConversationId,
    addMessage,
    reset,
  } = useChatStore();

  const mutation =
    useMutation({
      mutationFn:
        async (
          message: string
        ) =>
          sendChatMessage(
            message,
            conversationId
          ),

      onSuccess:
        (result) => {
          setConversationId(
            result.conversation_id
          );

          addMessage({
            id:
              crypto.randomUUID(),
            role:
              "assistant",
            content:
              result.response,
            actions:
              result.actions,
          });
        },
    });

  useEffect(() => {
    if (
      initialActionSent.current
    ) {
      return;
    }

    const doctor =
      searchParams.get(
        "doctor"
      );

    const date =
      searchParams.get(
        "date"
      );

    const time =
      searchParams.get(
        "time"
      );

    if (
      doctor &&
      date &&
      time
    ) {
      initialActionSent.current =
        true;

      submit(
        `Book ${doctor} on ${date} at ${time}`
      );

      return;
    }

    if (doctor) {
      initialActionSent.current =
        true;

      submit(
        `Show ${doctor}'s availability tomorrow`
      );
    }
  // We intentionally execute only once
  // for the initial deep-link action.
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({
      behavior: "smooth",
    });
  }, [
    messages,
    mutation.isPending,
  ]);


  function submit(
    value?: string
  ) {
    const message =
      (value ?? input).trim();

    if (
      !message ||
      mutation.isPending
    ) {
      return;
    }

    addMessage({
      id:
        crypto.randomUUID(),

      role:
        "user",

      content:
        message,
    });

    setInput("");

    mutation.mutate(
      message
    );
  }


  function onSubmit(
    event: FormEvent
  ) {
    event.preventDefault();

    submit();
  }


  return (
    <div className="mx-auto flex h-[calc(100vh-8rem)] max-w-5xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <div className="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <div>
          <h1 className="font-bold">
            MediBook AI
          </h1>

          <p className="mt-0.5 text-xs text-slate-500">
            Connected to real doctors,
            schedules and appointments
          </p>
        </div>

        <button
          onClick={reset}
          className="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs font-semibold hover:bg-slate-50"
        >
          <Plus
            size={14}
          />
          New conversation
        </button>
      </div>

      <div className="flex-1 overflow-y-auto bg-slate-50/60 p-5">
        {messages.length ===
        0 ? (
          <div className="mx-auto flex h-full max-w-xl flex-col items-center justify-center text-center">
            <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-600 text-white">
              <Bot
                size={25}
              />
            </div>

            <h2 className="mt-5 text-2xl font-bold">
              What can I help you
              arrange?
            </h2>

            <p className="mt-2 text-sm leading-6 text-slate-500">
              I can find doctors,
              check actual schedules,
              book appointments and
              manage existing bookings.
            </p>

            <div className="mt-6 grid w-full gap-2">
              {quickActions.map(
                (action) => (
                  <button
                    key={action}
                    onClick={() =>
                      submit(action)
                    }
                    className="rounded-xl border border-slate-200 bg-white px-4 py-3 text-left text-sm hover:border-emerald-300 hover:bg-emerald-50/30"
                  >
                    {action}
                  </button>
                )
              )}
            </div>
          </div>
        ) : (
          <div className="mx-auto max-w-3xl space-y-6">
            {messages.map(
              (message) => (
                <div
                  key={
                    message.id
                  }
                  className={[
                    "flex gap-3",
                    message.role ===
                    "user"
                      ? "justify-end"
                      : "justify-start",
                  ].join(" ")}
                >
                  {message.role ===
                    "assistant" && (
                    <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-600 text-white">
                      <Bot
                        size={15}
                      />
                    </div>
                  )}

                  <div
                    className={[
                      "max-w-[80%] whitespace-pre-wrap rounded-2xl px-4 py-3 text-sm leading-6",
                      message.role ===
                      "user"
                        ? "rounded-br-md bg-slate-950 text-white"
                        : "rounded-bl-md border border-slate-200 bg-white text-slate-700",
                    ].join(
                      " "
                    )}
                  >
                    {
                      message.content
                    }

                    {message.role ===
                      "assistant" &&
                      message.actions &&
                      message.actions.length >
                        0 && (
                        <ChatActions
                          actions={
                            message.actions
                          }
                          disabled={
                            mutation.isPending
                          }
                          onAction={(
                            action: ChatAction
                          ) =>
                            submit(
                              action.message
                            )
                          }
                        />
                      )}
                  </div>

                  {message.role ===
                    "user" && (
                    <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-200">
                      <UserRound
                        size={15}
                      />
                    </div>
                  )}
                </div>
              )
            )}

            {mutation.isPending && (
              <div className="flex items-center gap-3 text-sm text-slate-500">
                <LoaderCircle
                  size={16}
                  className="animate-spin"
                />

                MediBook is checking
                the system…
              </div>
            )}

            <div
              ref={bottomRef}
            />
          </div>
        )}
      </div>

      {mutation.isError && (
        <div className="border-t border-red-100 bg-red-50 px-5 py-3 text-sm text-red-700">
          MediBook could not complete
          that request. Your booking
          data was not changed.
        </div>
      )}

      <form
        onSubmit={onSubmit}
        className="border-t border-slate-200 bg-white p-4"
      >
        <div className="mx-auto flex max-w-3xl items-end gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-2 focus-within:border-emerald-400">
          <textarea
            value={input}
            onChange={(
              event
            ) =>
              setInput(
                event.target
                  .value
              )
            }
            onKeyDown={(
              event
            ) => {
              if (
                event.key ===
                  "Enter" &&
                !event.shiftKey
              ) {
                event.preventDefault();

                submit();
              }
            }}
            rows={1}
            placeholder="Ask MediBook…"
            className="max-h-32 min-h-10 flex-1 resize-none bg-transparent px-3 py-2 text-sm outline-none"
          />

          <button
            type="submit"
            disabled={
              !input.trim() ||
              mutation.isPending
            }
            className="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 text-white disabled:opacity-40"
          >
            {mutation.isPending ? (
              <LoaderCircle
                size={17}
                className="animate-spin"
              />
            ) : (
              <ArrowUp
                size={17}
              />
            )}
          </button>
        </div>
      </form>
    </div>
  );
}
