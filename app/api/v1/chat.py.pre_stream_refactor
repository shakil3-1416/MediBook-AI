from fastapi import (
    APIRouter,
    HTTPException,
)

from app.chatbot.actions import (
    build_chat_actions,
)
from app.chatbot.orchestrator import (
    handle_conversation,
)
from app.chatbot.session import (
    create_conversation_id,
    load_session,
)
from app.schemas.chat import (
    ChatAction,
    ChatRequest,
    ChatResponse,
)


router = APIRouter()


@router.post(
    "",
    response_model=ChatResponse,
)
async def chat(
    request: ChatRequest,
) -> ChatResponse:

    conversation_id = (
        request.conversation_id
        or create_conversation_id()
    )

    try:

        response = (
            await handle_conversation(
                conversation_id,
                request.message,
            )
        )

        state = await load_session(
            conversation_id
        )

        raw_actions = (
            build_chat_actions(
                state
            )
        )

        actions = [
            ChatAction(
                **action
            )
            for action in raw_actions
        ]

        return ChatResponse(
            response=response,
            conversation_id=(
                conversation_id
            ),
            actions=actions,
        )

    except Exception as exc:

        print(
            "CHAT ERROR:",
            repr(exc),
        )

        raise HTTPException(
            status_code=503,
            detail=(
                "MediBook AI is temporarily "
                "unable to complete that request."
            ),
        ) from exc


from fastapi.responses import StreamingResponse

from app.chatbot.streaming import (
    encode_event,
    stream_grounded_response,
)

from app.chatbot.stream_status import (
    status_for_message,
)

from app.schemas.chat import (
    ChatStreamEvent,
)


@router.post(
    "/stream",
    response_class=StreamingResponse,
)
async def stream_chat(
    request: ChatRequest,
) -> StreamingResponse:

    async def event_stream():

        try:
            yield encode_event(
                ChatStreamEvent(
                    type="status",
                    message=status_for_message(
                        request.message
                    ),
                )
            )

            result = await chat(
                request
            )

            async for event in (
                stream_grounded_response(
                    response=(
                        result.response
                    ),
                    conversation_id=(
                        result.conversation_id
                    ),
                    actions=(
                        getattr(
                            result,
                            "actions",
                            None,
                        )
                    ),
                )
            ):
                yield event

        except Exception:
            yield encode_event(
                ChatStreamEvent(
                    type="error",
                    message=(
                        "MediBook could not complete "
                        "that request."
                    ),
                )
            )

    return StreamingResponse(
        event_stream(),
        media_type=(
            "application/x-ndjson"
        ),
        headers={
            "Cache-Control": "no-cache",
            "X-Accel-Buffering": "no",
        },
    )
