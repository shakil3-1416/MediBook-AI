import re


TWELVE_HOUR_PATTERN = re.compile(
    r"\b"
    r"(?P<hour>1[0-2]|0?[1-9])"
    r"(?:\s*:\s*(?P<minute>[0-5]\d))?"
    r"\s*(?P<period>am|pm)"
    r"\b",
    re.IGNORECASE,
)


TWENTY_FOUR_HOUR_PATTERN = re.compile(
    r"\b"
    r"(?P<hour>[01]?\d|2[0-3])"
    r"\s*:\s*"
    r"(?P<minute>[0-5]\d)"
    r"\b",
)


def resolve_booking_time(
    text: str,
) -> str | None:
    """
    Convert a user-supplied appointment time to MediBook's
    canonical 24-hour HH:MM representation.

    Examples:
        5 PM       -> 17:00
        5:30 PM    -> 17:30
        12 PM      -> 12:00
        12 AM      -> 00:00
        17:30      -> 17:30

    This function is deterministic. An LLM must never decide
    appointment time arithmetic.
    """

    if not text:
        return None

    value = text.strip()


    # --------------------------------------------------
    # Explicit 12-hour clock with AM/PM
    # --------------------------------------------------

    match = TWELVE_HOUR_PATTERN.search(
        value
    )

    if match:

        hour = int(
            match.group("hour")
        )

        minute = int(
            match.group("minute")
            or "00"
        )

        period = (
            match.group("period")
            .lower()
        )


        if period == "am":

            if hour == 12:
                hour = 0

        else:

            if hour != 12:
                hour += 12


        return (
            f"{hour:02d}:"
            f"{minute:02d}"
        )


    # --------------------------------------------------
    # Explicit 24-hour clock
    # --------------------------------------------------

    match = (
        TWENTY_FOUR_HOUR_PATTERN
        .search(
            value
        )
    )

    if match:

        hour = int(
            match.group("hour")
        )

        minute = int(
            match.group("minute")
        )

        return (
            f"{hour:02d}:"
            f"{minute:02d}"
        )


    return None


def canonical_time(
    value: str,
) -> str | None:
    """
    Normalize a stored/displayed time using the same rules.
    """

    return resolve_booking_time(
        value
    )


def time_is_available(
    requested_time: str,
    available_times: list[str],
) -> bool:

    requested = canonical_time(
        requested_time
    )

    if requested is None:
        return False


    normalized = {
        canonical_time(value)
        for value in available_times
    }

    normalized.discard(
        None
    )

    return requested in normalized
