# ======================================================
# MEDIBOOK PRODUCTION ENVIRONMENT
# NEVER COMMIT REAL SECRET VALUES
# ======================================================

APP_ENV=production

# ------------------------------
# PostgreSQL
# ------------------------------

POSTGRES_DB=medibook
POSTGRES_USER=medibook
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

DATABASE_URL=postgresql+asyncpg://medibook:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/medibook


# ------------------------------
# Redis
# ------------------------------

REDIS_URL=redis://redis:6379/0


# ------------------------------
# Authentication
# ------------------------------

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=480


# ------------------------------
# Ollama
# ------------------------------

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b


# ------------------------------
# Public application
# ------------------------------

MEDIBOOK_DOMAIN=medibook.example.com
FRONTEND_ORIGIN=https://medibook.example.com


# ------------------------------
# Runtime
# ------------------------------

LOG_LEVEL=INFO

# Added for the M6/M7 release: integration security, email, storage.
MEDIBOOK_INTEGRATION_MASTER_KEY=CHANGE_ME
MEDIBOOK_OTP_SECRET=CHANGE_ME
MEDIBOOK_VERIFICATION_DELIVERY=smtp
MEDIBOOK_SMTP_HOST=CHANGE_ME
MEDIBOOK_SMTP_PORT=587
MEDIBOOK_SMTP_USERNAME=CHANGE_ME
MEDIBOOK_SMTP_PASSWORD=CHANGE_ME
MEDIBOOK_SMTP_FROM=no-reply@CHANGE_ME
MEDIBOOK_SMTP_TLS=true
MEDIBOOK_PROFILE_STORAGE=s3
MEDIBOOK_S3_BUCKET=CHANGE_ME
MEDIBOOK_S3_ENDPOINT_URL=https://CHANGE_ME
MEDIBOOK_S3_REGION=auto
MEDIBOOK_S3_ACCESS_KEY_ID=CHANGE_ME
MEDIBOOK_S3_SECRET_ACCESS_KEY=CHANGE_ME
MEDIBOOK_S3_PREFIX=profile-images
MEDIBOOK_RATE_LIMIT_ENABLED=true
